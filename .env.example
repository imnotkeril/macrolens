# Copy to ".env" in the project root for docker compose. Variables listed uncommented below are
# forwarded by docker-compose.yml (and docker-compose.prod.yml where noted). Commented variables
# are backend settings that compose does NOT forward: for local runs put them in backend/.env
# (see backend/.env.example), or add them to the backend `environment:` block to use them in Docker.

# --- Compose / paths / network ---
# Set to the project root if Docker resolves bind mounts wrongly (e.g. after moving the project).
# "." = run docker compose from the project root.
PROJECT_ROOT=.
# Dev defaults work locally. The prod overlay REQUIRES POSTGRES_PASSWORD, REDIS_PASSWORD and
# ADMIN_API_KEY (alphanumeric only: they are embedded in connection URLs).
# IMPORTANT: POSTGRES_PASSWORD only takes effect when the postgres volume is first created.
# Changing it later on an existing volume breaks the backend (alembic fails on boot and the
# container restarts). Either keep the original password, or run ALTER USER inside Postgres to
# match, or delete the pgdata volume (destroys data).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Host bind address for the frontend port (127.0.0.1 = local only; put a TLS reverse proxy in front).
FRONTEND_BIND=127.0.0.1

# --- Macro data ---
FRED_API_KEY=
HISTORICAL_YEARS=10
# Optional CoinGecko Pro key: long market_chart history (days=max); empty caps at 365 days.
COINGECKO_API_KEY=

# --- CORS ---
# Comma-separated allowed origins. In production set the frontend origin, e.g. https://macrolens.vercel.app.
# "*" allows all (disables credentials).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- API protection ---
# Non-GET requests under /api/ need `X-API-Key: <ADMIN_API_KEY>` (fail-closed: 503 if unset),
# except POST /api/alerts/{id}/read and POST /api/alerts/read-all.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# LOCAL DEV ONLY: skip the key check. Must be false anywhere reachable from the internet.
ALLOW_UNAUTHENTICATED_ADMIN=false
# true only behind a proxy you control (forwarded by the prod overlay).
RATE_LIMIT_TRUST_PROXY=false
# Not forwarded by docker-compose.yml (defaults shown):
# RATE_LIMIT_PER_MINUTE=240
# RATE_LIMIT_ADMIN_PER_MINUTE=20
# MAX_REQUEST_BODY_BYTES=1048576

# --- Forecast Lab ---
# First month-end included in training features.
FORECAST_LAB_DATE_FROM=2008-01-01
# Summary as_of defaults to the last completed month-end when true.
FORECAST_LAB_SUMMARY_ALIGN_MONTH_END=false
# GBDT/HMM target: rule_v1 | asset_implied_v1
FORECAST_LAB_LABEL_MODE=asset_implied_v1
# After POST /api/forecast-lab/log-snapshot, also upsert a memory document.
FORECAST_LAB_MEMORY_INGEST_ENABLED=false
# Adds the Navigator and Cycle Radar cross-check block to GET /api/forecast-lab/summary.
FORECAST_LAB_INCLUDE_DASHBOARD_CONTEXT=true
# GBDT sample weight from asset pair agreement (asset_implied_v1 only); 0 = off.
FORECAST_LAB_AUXILIARY_ASSET_WEIGHT=0.35
# Fourth ensemble expert: Cycle Radar mapped to quadrant prior.
FORECAST_LAB_ENSEMBLE_INCLUDE_CYCLE=true
# Train recession_xgb.json on forward 12-month recession labels.
FORECAST_LAB_TRAIN_RECESSION_MODEL=true

# --- Agents / memory (optional; empty = rule fallbacks, no external API calls) ---
# Anthropic Claude: text generation for agent cards. Not ChatGPT.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT_SECONDS=120
# OpenAI: embeddings only (memory retrieval, text-embedding-*). No GPT chat in this code.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=60
# auto (OpenAI embeddings when OPENAI_API_KEY is set, else hash) | hash | openai
MEMORY_EMBEDDING_BACKEND=auto
# Not forwarded by docker-compose.yml (defaults shown):
# LLM_MAX_RETRIES=2
# MEMORY_EMBEDDING_DIM=128
# MEMORY_DEFAULT_TOP_K=5
# MEMORY_MIN_QUALITY_THRESHOLD=0.0

# --- Telegram news ingestion (optional) ---
# For channel history use a Telethon user session file at TELEGRAM_SESSION_PATH; bot tokens often cannot read channels.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SESSION_PATH=
TELEGRAM_CHANNEL_WHITELIST=
TELEGRAM_INGESTION_ENABLED=false
TELEGRAM_INGEST_MAX_MESSAGES=80

# --- Debug (dev only) ---
# NDJSON debug sink. Leave EMPTY in production.
DEBUG_LOG_PATH=

# --- Not forwarded by docker-compose.yml (defaults shown) ---
# CALENDAR_CANARY_ENABLED=true
# CALENDAR_CANARY_DAYS_AHEAD=45
# FRED_RATE_LIMIT=120
# NEUTRAL_RATE_FALLBACK=2.5
# CME_FEDWATCH_RT_BASE=https://markets.api.cmegroup.com/fedwatch_rt/v1
# CME_FEDWATCH_BEARER_TOKEN=
# ML_DATASET_PATH=data/ml_navigator_dataset.parquet
# ML_ARTIFACTS_DIR=data/ml_artifacts
# ML_TRAIN_PROGRESS_FILE=data/ml_train_progress.json
# ML_DATASET_MAX_YEARS=5
# ML_TRAIN_END=2018-12
# ML_VAL_END=2021-12
# ML_RANDOM_SEED=42
# FORECAST_LAB_ARTIFACTS_DIR=data/forecast_lab_artifacts
# FORECAST_LAB_TRAIN_PROGRESS_FILE=data/forecast_lab_train_progress.json
# FORECAST_LAB_ENABLE_TRAIN_ENDPOINT=true
# FORECAST_LAB_HMM_STATES=4
# FORECAST_LAB_RANDOM_SEED=42
# FORECAST_LAB_TRAIN_END=2018-12
# FORECAST_LAB_VAL_END=2021-12

# --- Frontend (Next.js rewrite target; set by compose, not needed in this file) ---
# BACKEND_INTERNAL_URL=http://backend:8000
