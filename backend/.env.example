# Copy to backend/.env (used when running uvicorn from backend/). Pydantic reads it from the
# working directory. Every variable below maps to a field in backend/app/config.py (Settings);
# unset variables use the default shown in the comment. Never commit the real .env.

# --- Storage ---
DATABASE_URL=postgresql+asyncpg://macrolens:macrolens_secret@localhost:5432/macrolens
REDIS_URL=redis://localhost:6379/0

# --- Macro data ---
FRED_API_KEY=
# FRED request budget per minute (default 120).
FRED_RATE_LIMIT=120
# Rolling window for FRED/Yahoo bulk history loads, in years (default 10).
HISTORICAL_YEARS=10
# Optional CoinGecko Pro key: enables long market_chart history (days=max); empty caps at 365 days.
COINGECKO_API_KEY=

# --- CORS ---
# Comma-separated origins. Dev default below; in production set your frontend origin,
# e.g. https://macrolens.vercel.app. "*" allows all (disables credentials).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000

# --- API protection ---
# Non-GET requests under /api/ need the header `X-API-Key: <ADMIN_API_KEY>` (fail-closed: 503 if unset),
# except POST /api/alerts/{id}/read and POST /api/alerts/read-all.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# LOCAL DEV ONLY: skip the key check. Must be false anywhere reachable from the internet.
ALLOW_UNAUTHENTICATED_ADMIN=false
# Per-client-IP requests per minute (0 = off); non-GET requests use the stricter second limit.
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_ADMIN_PER_MINUTE=20
# true only behind a proxy you control (uses first X-Forwarded-For hop as client IP).
RATE_LIMIT_TRUST_PROXY=false
# Max request body, bytes (applies to non-GET requests).
MAX_REQUEST_BODY_BYTES=1048576

# --- Calendar canary ---
CALENDAR_CANARY_ENABLED=true
CALENDAR_CANARY_DAYS_AHEAD=45

# --- Neutral policy anchor ---
# Fallback neutral Fed funds rate (%) when FRED FEDTARMDLR is not available.
NEUTRAL_RATE_FALLBACK=2.5

# --- CME FedWatch (optional) ---
CME_FEDWATCH_RT_BASE=https://markets.api.cmegroup.com/fedwatch_rt/v1
CME_FEDWATCH_BEARER_TOKEN=

# --- ML regime (legacy /api/ml) ---
ML_DATASET_PATH=data/ml_navigator_dataset.parquet
ML_ARTIFACTS_DIR=data/ml_artifacts
ML_TRAIN_PROGRESS_FILE=data/ml_train_progress.json
ML_DATASET_MAX_YEARS=5
ML_TRAIN_END=2018-12
ML_VAL_END=2021-12
ML_RANDOM_SEED=42

# --- Forecast Lab ---
FORECAST_LAB_ARTIFACTS_DIR=data/forecast_lab_artifacts
FORECAST_LAB_TRAIN_PROGRESS_FILE=data/forecast_lab_train_progress.json
FORECAST_LAB_ENABLE_TRAIN_ENDPOINT=true
FORECAST_LAB_HMM_STATES=4
FORECAST_LAB_RANDOM_SEED=42
# First month-end included in training features (needs indicator/yield history for this range).
FORECAST_LAB_DATE_FROM=2008-01-01
FORECAST_LAB_TRAIN_END=2018-12
FORECAST_LAB_VAL_END=2021-12
# Summary as_of defaults to the last completed month-end when true.
FORECAST_LAB_SUMMARY_ALIGN_MONTH_END=false
# GBDT/HMM target: rule_v1 | asset_implied_v1
FORECAST_LAB_LABEL_MODE=asset_implied_v1
# After POST /api/forecast-lab/log-snapshot, also upsert a memory document.
FORECAST_LAB_MEMORY_INGEST_ENABLED=false
# GET /api/forecast-lab/summary includes Navigator + Cycle Radar cross-check block.
FORECAST_LAB_INCLUDE_DASHBOARD_CONTEXT=true
# GBDT sample weight from asset pair agreement (asset_implied_v1 only); 0 = off.
FORECAST_LAB_AUXILIARY_ASSET_WEIGHT=0.35
# Fourth ensemble expert: Cycle Radar mapped to quadrant prior.
FORECAST_LAB_ENSEMBLE_INCLUDE_CYCLE=true
# Train recession_xgb.json on forward 12-month recession labels.
FORECAST_LAB_TRAIN_RECESSION_MODEL=true

# --- Agents / LLM (optional; leave empty = rule fallbacks, no external API calls) ---
# Anthropic Claude: text generation for Fed / News / Macro / Master agents.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# --- Memory / embeddings ---
# OpenAI: embeddings only (memory retrieval). Not used for chat in this project.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=60
# auto (OpenAI embeddings when OPENAI_API_KEY is set, else hash) | hash | openai
MEMORY_EMBEDDING_BACKEND=auto
MEMORY_EMBEDDING_DIM=128
MEMORY_DEFAULT_TOP_K=5
MEMORY_MIN_QUALITY_THRESHOLD=0.0

# --- Telegram news ingestion (optional) ---
# For channel history use a user session file (Telethon) at TELEGRAM_SESSION_PATH.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SESSION_PATH=
TELEGRAM_CHANNEL_WHITELIST=
TELEGRAM_INGESTION_ENABLED=false
TELEGRAM_INGEST_MAX_MESSAGES=80

# --- Debug (dev only) ---
# NDJSON debug sink. Leave EMPTY in production (no file is written when unset).
DEBUG_LOG_PATH=
